# Root .gitignore for the laarilaara.com monorepo (backend/ + frontend/ +
# deployment/). Each subfolder also has its own more specific .gitignore;
# this one is the safety net so nothing sensitive or generated ever gets
# tracked no matter where it's added from.

# --- Secrets: never commit, anywhere in the repo ---
.env
.env.*
!**/.env.example
!**/.env.local.example
**/config.yaml
!**/config.yaml.example
*.pem
*.key
credentials.json
service-account*.json

# --- Python (backend/) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js (frontend/) ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# --- Terraform / IaC (deployment/) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# --- Build / packaging artifacts ---
build/
dist/
*.zip
.aws-sam/

# --- Editor / OS noise ---
.DS_Store
.vscode/*
!.vscode/extensions.json
