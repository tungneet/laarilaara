# Copy to .env.local and adjust per environment.
# Base URL of the LaariLaara FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Web client ID ("Sign in with Google") — not secret, safe to
# expose to the browser. Leave blank to hide the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
