# Copy to .env for local development. NEVER commit a real .env.
# Only secrets and per-environment overrides belong here.
# Non-secret structural config lives in config.yaml.

# Environment
LAARA_ENVIRONMENT=local
LAARA_LOG_LEVEL=INFO

# Secrets (leave blank locally when using the fake AI provider)
LAARA_OPENAI_API_KEY=

# Example nested overrides (uncomment to override config.yaml):
# LAARA_AI__PROVIDER=openai
# LAARA_AI__OPENAI_BASE_URL=http://localhost:11434/v1
# LAARA_STORAGE__DYNAMODB_ENDPOINT_URL=http://localhost:8000
